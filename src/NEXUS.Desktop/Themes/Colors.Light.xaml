<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================ -->
    <!-- NEXUS EMERALD LIGHT THEME (Clean High-Contrast Palette)           -->
    <!-- Canvas: Crisp White (#F8FAFC) • Accent: Emerald (#10B981)        -->
    <!-- ================================================================ -->

    <!-- Canvas & Surfaces -->
    <Color x:Key="Color.Background.Primary">#F1F5F9</Color>
    <Color x:Key="Color.Background.Secondary">#FFFFFF</Color>
    <Color x:Key="Color.Background.Tertiary">#E2E8F0</Color>
    <Color x:Key="Color.Background.Elevated">#FFFFFF</Color>
    <Color x:Key="Color.Background.Sidebar">#E2E8F0</Color>
    <Color x:Key="Color.Background.DropZone">#ECFDF5</Color>

    <!-- Borders & Dividers -->
    <Color x:Key="Color.Border.Subtle">#CBD5E1</Color>
    <Color x:Key="Color.Border.Active">#10B981</Color>
    <Color x:Key="Color.Border.Hover">#059669</Color>
    <Color x:Key="Color.Border.DropZone">#10B981</Color>

    <!-- Emerald & Mint Accents -->
    <Color x:Key="Color.Accent.Primary">#10B981</Color>
    <Color x:Key="Color.Accent.Hover">#059669</Color>
    <Color x:Key="Color.Accent.Pressed">#047857</Color>
    <Color x:Key="Color.Accent.Muted">#D1FAE5</Color>
    <Color x:Key="Color.Accent.Soft">#6EE7B7</Color>
    <Color x:Key="Color.Accent.Glow">#2010B981</Color>

    <!-- Status Indicators -->
    <Color x:Key="Color.Status.Success">#10B981</Color>
    <Color x:Key="Color.Status.SuccessText">#047857</Color>
    <Color x:Key="Color.Status.Warning">#D97706</Color>
    <Color x:Key="Color.Status.WarningText">#B45309</Color>
    <Color x:Key="Color.Status.Danger">#DC2626</Color>
    <Color x:Key="Color.Status.DangerText">#B91C1C</Color>
    <Color x:Key="Color.Status.Info">#059669</Color>

    <!-- Typography (High contrast for light theme) -->
    <Color x:Key="Color.Text.Primary">#0F172A</Color>
    <Color x:Key="Color.Text.Secondary">#475569</Color>
    <Color x:Key="Color.Text.Tertiary">#64748B</Color>
    <Color x:Key="Color.Text.Disabled">#94A3B8</Color>
    <Color x:Key="Color.Text.OnAccent">#FFFFFF</Color>
    <Color x:Key="Color.Text.Highlight">#047857</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="Brush.Background.Primary" Color="{StaticResource Color.Background.Primary}" />
    <SolidColorBrush x:Key="Brush.Background.Secondary" Color="{StaticResource Color.Background.Secondary}" />
    <SolidColorBrush x:Key="Brush.Background.Tertiary" Color="{StaticResource Color.Background.Tertiary}" />
    <SolidColorBrush x:Key="Brush.Background.Elevated" Color="{StaticResource Color.Background.Elevated}" />
    <SolidColorBrush x:Key="Brush.Background.Sidebar" Color="{StaticResource Color.Background.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Background.DropZone" Color="{StaticResource Color.Background.DropZone}" />

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="Brush.Border.Active" Color="{StaticResource Color.Border.Active}" />
    <SolidColorBrush x:Key="Brush.Border.Hover" Color="{StaticResource Color.Border.Hover}" />
    <SolidColorBrush x:Key="Brush.Border.DropZone" Color="{StaticResource Color.Border.DropZone}" />

    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Muted" Color="{StaticResource Color.Accent.Muted}" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="{StaticResource Color.Accent.Soft}" />
    <SolidColorBrush x:Key="Brush.Accent.Glow" Color="{StaticResource Color.Accent.Glow}" />

    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}" />
    <SolidColorBrush x:Key="Brush.Status.SuccessText" Color="{StaticResource Color.Status.SuccessText}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}" />
    <SolidColorBrush x:Key="Brush.Status.WarningText" Color="{StaticResource Color.Status.WarningText}" />
    <SolidColorBrush x:Key="Brush.Status.Danger" Color="{StaticResource Color.Status.Danger}" />
    <SolidColorBrush x:Key="Brush.Status.DangerText" Color="{StaticResource Color.Status.DangerText}" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="{StaticResource Color.Status.Info}" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Text.Highlight" Color="{StaticResource Color.Text.Highlight}" />

    <!-- Subtle Emerald Accent Gradients -->
    <LinearGradientBrush x:Key="Brush.Gradient.EmeraldHero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0" />
        <GradientStop Color="#059669" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Gradient.EmeraldGlow" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E6F4EA" Offset="0" />
        <GradientStop Color="#D1FAE5" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
