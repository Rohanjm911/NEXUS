<Window x:Class="NEXUS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NEXUS.Desktop.ViewModels"
        xmlns:views="clr-namespace:NEXUS.Desktop.Views"
        mc:Ignorable="d"
        Title="NEXUS — Any Format. One Destination." 
        Icon="Assets/app.ico"
        Height="760" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background.Primary}"
        Foreground="{StaticResource Brush.Text.Primary}"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        StateChanged="OnWindowStateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="8"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- DataTemplates mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UniversalConversionViewModel}">
            <views:UniversalConversionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImageStudioViewModel}">
            <views:ImageStudioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioStudioViewModel}">
            <views:AudioStudioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VideoStudioViewModel}">
            <views:VideoStudioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PdfStudioViewModel}">
            <views:PdfStudioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArchiveManagerViewModel}">
            <views:ArchiveManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevToolkitViewModel}">
            <views:DevToolkitView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessingCenterViewModel}">
            <views:ProcessingCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutomationCenterViewModel}">
            <views:AutomationCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageAnalyzerViewModel}">
            <views:StorageAnalyzerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Outer Border for 1px subtle dark border -->
        <Border x:Name="RootBorder" Background="{StaticResource Brush.Background.Primary}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title Bar & Header -->
                <Border Grid.Row="0" Background="{StaticResource Brush.Background.Sidebar}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" MouseDown="OnTitleBarMouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Brand Logo & Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <TextBlock Text="NEXUS" FontWeight="Bold" FontSize="{StaticResource FontSize.Subheader}" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Global Command Palette Search Bar Trigger -->
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleCommandPaletteCommand}" HorizontalAlignment="Center" Width="440" Height="28" Padding="10,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="420">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Search}" Fill="{StaticResource Brush.Text.Tertiary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Search tools, conversions, studios..." FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                </StackPanel>
                                <Border Style="{StaticResource NexusBadgeStyle}" HorizontalAlignment="Right" Background="{StaticResource Brush.Background.Elevated}" Padding="6,1">
                                    <TextBlock Text="Ctrl + K" FontSize="10" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Quick System Stats Pill -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Border Style="{StaticResource NexusBadgeStyle}" Background="{StaticResource Brush.Background.Tertiary}" Margin="0,0,6,0">
                                <TextBlock Text="{Binding QuickCpuPercentage, StringFormat={}CPU {0:F0}%}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" />
                            </Border>
                            <Border Style="{StaticResource NexusBadgeStyle}" Background="{StaticResource Brush.Background.Tertiary}">
                                <TextBlock Text="{Binding QuickRamPercentage, StringFormat={}RAM {0:F0}%}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" />
                            </Border>
                        </StackPanel>

                        <!-- Window Controls (Min, Max, Close) -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource WindowButtonStyle}" Click="OnMinimizeClick">
                                <Path Data="{StaticResource Icon.Minimize}" Fill="{StaticResource Brush.Text.Secondary}" Width="10" Height="2" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="MaximizeBtn" Style="{StaticResource WindowButtonStyle}" Click="OnMaximizeClick" ToolTip="Maximize">
                                <Path x:Name="MaximizeIcon" Data="{StaticResource Icon.Maximize}" Fill="{StaticResource Brush.Text.Secondary}" Width="10" Height="10" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource WindowCloseButtonStyle}" Click="OnCloseClick">
                                <Path Data="{StaticResource Icon.Close}" Fill="{StaticResource Brush.Text.Secondary}" Width="10" Height="10" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Layout (Sidebar + Content Area) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Navigation Sidebar -->
                    <Border Grid.Column="0" Background="{StaticResource Brush.Background.Sidebar}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8,12,8,8">
                                    <TextBlock Text="STUDIOS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="12,6,0,6" />

                                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Tag="{Binding CurrentViewName}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Dashboard}" Fill="{StaticResource Brush.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                            <TextBlock Text="Command Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Universal">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Convert}" Fill="{StaticResource Brush.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                            <TextBlock Text="Universal Studio" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Image">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Image}" Fill="{StaticResource Brush.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                            <TextBlock Text="Image Studio" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Audio">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Audio}" Fill="{StaticResource Brush.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                            <TextBlock Text="Audio Studio" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Video">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Video}" Fill="{StaticResource Brush.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                            <TextBlock Text="Video Studio" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Pdf">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Pdf}" Fill="{StaticResource Brush.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                            <TextBlock Text="PDF Studio" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Archive">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Archive}" Fill="{StaticResource Brush.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                            <TextBlock Text="Archive Manager" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="DevTools">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Code}" Fill="{StaticResource Brush.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                            <TextBlock Text="Developer Toolkit" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="MANAGEMENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="12,18,0,6" />

                                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Processing">
                                        <Grid Width="200">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Queue}" Fill="{StaticResource Brush.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                                <TextBlock Text="Processing Center" />
                                            </StackPanel>
                                            <Border Style="{StaticResource NexusBadgeStyle}" HorizontalAlignment="Right" Background="{StaticResource Brush.Accent.Muted}">
                                                <TextBlock Text="{Binding ActiveTasksCount}" FontSize="10" Foreground="{StaticResource Brush.Accent.Hover}" />
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Automation">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Automation}" Fill="{StaticResource Brush.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                            <TextBlock Text="Automation Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Storage">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Storage}" Fill="{StaticResource Brush.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                            <TextBlock Text="Storage Analyzer" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Bottom Settings Button -->
                            <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Padding="8,8">
                                <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Settings}" Fill="{StaticResource Brush.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" />
                                        <TextBlock Text="Settings &amp; Info" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Main Dynamic Content Area -->
                    <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
                </Grid>

                <!-- Command Palette Modal Overlay -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Background="#A0000000" Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisConverter}}" x:Name="CommandPaletteOverlay" MouseDown="OnOverlayMouseDown">
                    <Border Width="600" Height="420" VerticalAlignment="Top" Margin="0,80,0,0" Style="{StaticResource NexusCardStyle}" Background="{StaticResource Brush.Background.Secondary}" BorderBrush="{StaticResource Brush.Border.Active}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0" Style="{StaticResource NexusTextBoxStyle}" Text="{Binding CommandPaletteQuery, UpdateSourceTrigger=PropertyChanged}" FontSize="{StaticResource FontSize.Subheader}" Padding="12,10" x:Name="CommandQueryBox" KeyDown="OnCommandQueryKeyDown" />

                            <ListBox Grid.Row="1" ItemsSource="{Binding FilteredCommands}" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" SelectionChanged="OnCommandSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" CornerRadius="6" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnCommandItemClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource NexusBadgeStyle}" Background="{StaticResource Brush.Background.Tertiary}">
                                                    <TextBlock Text="{Binding Shortcut}" FontSize="10" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Toast Notifications Stack (Top-Right) -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Notifications}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Width="320" IsHitTestVisible="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,8" Background="{StaticResource Brush.Background.Elevated}" BorderBrush="{StaticResource Brush.Accent.Primary}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Message}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Border>
    </Grid>
</Window>

