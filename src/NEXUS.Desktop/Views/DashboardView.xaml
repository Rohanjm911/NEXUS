<UserControl x:Class="NEXUS.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:NEXUS.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            
            <!-- ============================================================== -->
            <!-- WELCOME & HERO HEADER                                          -->
            <!-- ============================================================== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource Brush.Background.Secondary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Margin="0,0,16,0">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NEXUS COMMAND CENTER" FontSize="{StaticResource FontSize.Hero}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" />
                            <Border Style="{StaticResource NexusBadgeStyle}" Background="{DynamicResource Brush.Accent.Muted}" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="EMERALD EDITION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Hover}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Welcome back • Privacy-First Universal Desktop Processing Engine • Local-Only" FontSize="{StaticResource FontSize.Subheader}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource NexusBadgeStyle}" Background="{DynamicResource Brush.Background.Secondary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Margin="0,0,10,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Status.Success}" Margin="0,0,8,0" />
                            <TextBlock Text="Engine Online (\\.\pipe\nexus-engine)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Status.SuccessText}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Convert}" Fill="{DynamicResource Brush.Text.Primary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Refresh Stats" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================================================== -->
            <!-- QUICK ACTIONS DOCK (1-Click Workflow Launchers)                -->
            <!-- ============================================================== -->
            <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,24" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="QUICK ACTIONS DOCK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="0,0,20,0" />

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Universal" Height="32" Padding="14,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Convert}" Fill="{DynamicResource Brush.Accent.Hover}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Universal Studio" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Image" Height="32" Padding="14,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Image}" Fill="{DynamicResource Brush.Accent.Hover}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Image Master" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Upscaler" Height="32" Padding="14,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Sparkle}" Fill="{DynamicResource Brush.Accent.Hover}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Image Upscaler" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Audio" Height="32" Padding="14,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Audio}" Fill="{DynamicResource Brush.Accent.Hover}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Audio Converter" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Video" Height="32" Padding="14,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Video}" Fill="{DynamicResource Brush.Accent.Hover}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Video Transcoder" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Pdf" Height="32" Padding="14,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Pdf}" Fill="{DynamicResource Brush.Accent.Hover}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="PDF Tools" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Archive" Height="32" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Archive}" Fill="{DynamicResource Brush.Accent.Hover}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Archive Manager" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ============================================================== -->
            <!-- PROCESSING & SYSTEM TELEMETRY OVERVIEW CARDS                   -->
            <!-- ============================================================== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU UTILIZATION" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <Path Data="{StaticResource Icon.Cpu}" Fill="{DynamicResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F1}%}" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold" Margin="0,8,0,8" />
                        <ProgressBar Style="{StaticResource NexusProgressBarStyle}" Value="{Binding CpuUsage}" Maximum="100" />
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="2" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="SYSTEM MEMORY" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <Path Data="{StaticResource Icon.Ram}" Fill="{DynamicResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding RamUsage, StringFormat={}{0:F0}%}" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding RamText}" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8" />
                        <ProgressBar Style="{StaticResource NexusProgressBarStyle}" Value="{Binding RamUsage}" Maximum="100" />
                    </StackPanel>
                </Border>

                <!-- Active Tasks -->
                <Border Grid.Column="4" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="ACTIVE PROCESSING" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <Path Data="{StaticResource Icon.Queue}" Fill="{DynamicResource Brush.Status.Info}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding ActiveCount}" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding ProcessingSpeed, StringFormat={}Throughput: {0}}" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Status.SuccessText}" />
                    </StackPanel>
                </Border>

                <!-- Completed Tasks -->
                <Border Grid.Column="6" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TOTAL COMPLETED" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <Path Data="{StaticResource Icon.Check}" Fill="{DynamicResource Brush.Status.SuccessText}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding CompletedCount}" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding FailedCount, StringFormat={}Failed: {0}}" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Status.DangerText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================================== -->
            <!-- DRAG & DROP QUICK WORKSPACE                                    -->
            <!-- ============================================================== -->
            <Border x:Name="DropZoneBorder" 
                    Background="{DynamicResource Brush.Background.DropZone}"
                    BorderBrush="{DynamicResource Brush.Border.DropZone}"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Padding="36,28"
                    Margin="0,0,0,28"
                    AllowDrop="True"
                    Drop="OnDropFiles"
                    DragEnter="OnDragEnter"
                    DragLeave="OnDragLeave"
                    Cursor="Hand">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource Icon.Drop}" Fill="{DynamicResource Brush.Accent.Primary}" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Drag and drop files or folders here" FontSize="{StaticResource FontSize.Header}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Universal batch recognition: Images, Audio, Video, Documents, and Archives automatically routed to engine" FontSize="{StaticResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- ============================================================== -->
            <!-- FORMAT CATEGORY GRID                                           -->
            <!-- ============================================================== -->
            <TextBlock Text="Specialized Studios &amp; Capabilities" FontSize="{StaticResource FontSize.Header}" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Images Card -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource Icon.Image}" Fill="{DynamicResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Image Studio" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="PNG, JPG, WEBP, AVIF, TIFF, BMP, SVG, GIF (Lanczos3 rescaler)" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Audio Card -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource Icon.Audio}" Fill="{DynamicResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Audio Studio" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="MP3, WAV, FLAC, AAC, OGG, M4A, WMA (Lossless &amp; VBR)" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Video Card -->
                <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource Icon.Video}" Fill="{DynamicResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Video Studio" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="MP4, MKV, MOV, AVI, WEBM, WMV (H.264, VP9 transcoding)" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Documents Card -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource Icon.Pdf}" Fill="{DynamicResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Document &amp; PDF" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="PDF Linear Merge, DOCX, DOC, TXT, ODT, RTF Document Tools" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Archives Card -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource Icon.Archive}" Fill="{DynamicResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Archive Manager" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="ZIP, 7Z, TAR, GZ, RAR (Path traversal security hardened)" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Dev Toolkit Card -->
                <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource Icon.Code}" Fill="{DynamicResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Developer Toolkit" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="Offline JSON Formatter, Base64, SHA-256, SHA-512, MD5, Hex Viewer" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================================== -->
            <!-- RECENT PROCESSING ACTIVITY                                     -->
            <!-- ============================================================== -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Recent Processing Activity" FontSize="{StaticResource FontSize.Header}" FontWeight="SemiBold" />
            </Grid>

            <Border Style="{StaticResource NexusCardStyle}">
                <ItemsControl ItemsSource="{Binding RecentTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Name & Source -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SourceFilePath}" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Format Pill -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                        <Border Style="{StaticResource NexusBadgeStyle}">
                                            <TextBlock Text="{Binding SourceFormat, StringFormat={}.{0}}" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Accent.Hover}" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text=" → " Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="4,0" />
                                        <Border Style="{StaticResource NexusBadgeStyle}" Background="{DynamicResource Brush.Background.Tertiary}">
                                            <TextBlock Text="{Binding TargetFormat, StringFormat={}.{0}}" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Progress / Status -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                        <ProgressBar Style="{StaticResource NexusProgressBarStyle}" Value="{Binding ProgressPercentage}" Maximum="100" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="3" Text="{Binding CreatedAt, StringFormat={}{0:HH:mm:ss}}" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
