<UserControl x:Class="NEXUS.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:NEXUS.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            
            <!-- Hero Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="52" Height="52" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NEXUS COMMAND CENTER" FontSize="{StaticResource FontSize.Hero}" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                        <TextBlock Text="Universal File Conversion &amp; Processing Engine • Offline &amp; Privacy-First" FontSize="{StaticResource FontSize.Subheader}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Convert}" Fill="{StaticResource Brush.Text.Primary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh Stats" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Metrics Overview Cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU LOAD" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" />
                            <Path Data="{StaticResource Icon.Cpu}" Fill="{StaticResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F1}%}" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold" Margin="0,8,0,8" />
                        <ProgressBar Style="{StaticResource NexusProgressBarStyle}" Value="{Binding CpuUsage}" Maximum="100" />
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="2" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="SYSTEM MEMORY" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" />
                            <Path Data="{StaticResource Icon.Ram}" Fill="{StaticResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding RamUsage, StringFormat={}{0:F0}%}" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding RamText}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,8" />
                        <ProgressBar Style="{StaticResource NexusProgressBarStyle}" Value="{Binding RamUsage}" Maximum="100" />
                    </StackPanel>
                </Border>

                <!-- Active Tasks -->
                <Border Grid.Column="4" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="ACTIVE PROCESSING" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" />
                            <Path Data="{StaticResource Icon.Queue}" Fill="{StaticResource Brush.Status.Info}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding ActiveCount}" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding ProcessingSpeed, StringFormat={}Throughput: {0}}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Status.SuccessText}" />
                    </StackPanel>
                </Border>

                <!-- Completed Tasks -->
                <Border Grid.Column="6" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TOTAL COMPLETED" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" />
                            <Path Data="{StaticResource Icon.Check}" Fill="{StaticResource Brush.Status.SuccessText}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding CompletedCount}" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding FailedCount, StringFormat={}Failed: {0}}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Status.DangerText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Drag & Drop Quick Area -->
            <Border x:Name="DropZoneBorder" 
                    Background="{StaticResource Brush.Background.DropZone}"
                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="32"
                    Margin="0,0,0,28"
                    AllowDrop="True"
                    Drop="OnDropFiles"
                    DragEnter="OnDragEnter"
                    DragLeave="OnDragLeave"
                    Cursor="Hand">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource Icon.Drop}" Fill="{StaticResource Brush.Accent.Primary}" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Drag and drop files here to convert" FontSize="{StaticResource FontSize.Header}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Universal support: Images, Audio, Video, Documents, and Archives are automatically recognized" FontSize="{StaticResource FontSize.Body}" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Format Category Grid -->
            <TextBlock Text="Supported Formats &amp; Studios" FontSize="{StaticResource FontSize.Header}" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Images Card -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource Icon.Image}" Fill="{StaticResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Image Studio" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="PNG, JPG, WEBP, AVIF, TIFF, BMP, SVG, GIF" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Audio Card -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource Icon.Audio}" Fill="{StaticResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Audio Studio" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="MP3, WAV, FLAC, AAC, OGG, M4A, WMA" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Video Card -->
                <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource Icon.Video}" Fill="{StaticResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Video Studio" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="MP4, MKV, MOV, AVI, WEBM, WMV, FLV" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Documents Card -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource Icon.Pdf}" Fill="{StaticResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Document &amp; PDF" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="PDF, DOCX, DOC, TXT, ODT, RTF" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Archives Card -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource Icon.Archive}" Fill="{StaticResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Archive Manager" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="ZIP, 7Z, RAR, TAR, GZ" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Dev Toolkit Card -->
                <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource Icon.Code}" Fill="{StaticResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Developer Toolkit" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="JSON Formatter, Base64, MD5, SHA-256, Hex Viewer" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Tasks List -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Recent Processing Activity" FontSize="{StaticResource FontSize.Header}" FontWeight="SemiBold" />
            </Grid>

            <Border Style="{StaticResource NexusCardStyle}">
                <ItemsControl ItemsSource="{Binding RecentTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Name & Source -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SourceFilePath}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" />
                                    </StackPanel>

                                    <!-- Format Pill -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                        <Border Style="{StaticResource NexusBadgeStyle}">
                                            <TextBlock Text="{Binding SourceFormat}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Accent.Hover}" />
                                        </Border>
                                        <TextBlock Text=" → " Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="4,0" />
                                        <Border Style="{StaticResource NexusBadgeStyle}" Background="{StaticResource Brush.Background.Tertiary}">
                                            <TextBlock Text="{Binding TargetFormat}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Primary}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Progress / Status -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                        <ProgressBar Style="{StaticResource NexusProgressBarStyle}" Value="{Binding ProgressPercentage}" Maximum="100" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="3" Text="{Binding CreatedAt, StringFormat={}{0:HH:mm:ss}}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

