<UserControl x:Class="NEXUS.Desktop.Views.DevToolkitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NEXUS.Desktop.ViewModels"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="DEVELOPER TOOLKIT" FontSize="{StaticResource FontSize.Hero}" FontWeight="Bold" />
                <TextBlock Text="Offline utilities: JSON formatter &amp; validator, Base64 encoder/decoder, Cryptographic hashing (SHA-256, SHA-512, MD5) &amp; Hex analysis" FontSize="{StaticResource FontSize.Subheader}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Utility Bar -->
            <Border Grid.Row="1" Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16">
                <WrapPanel>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding FormatJsonCommand}" Height="36" Padding="14,0" Margin="0,0,8,8">
                        <TextBlock Text="Format JSON" FontWeight="SemiBold" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ValidateJsonCommand}" Height="36" Padding="14,0" Margin="0,0,8,8">
                        <TextBlock Text="Validate JSON" FontWeight="SemiBold" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Base64EncodeCommand}" Height="36" Padding="14,0" Margin="0,0,8,8">
                        <TextBlock Text="Base64 Encode" FontWeight="SemiBold" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Base64DecodeCommand}" Height="36" Padding="14,0" Margin="0,0,8,8">
                        <TextBlock Text="Base64 Decode" FontWeight="SemiBold" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ComputeSha256Command}" Height="36" Padding="14,0" Margin="0,0,8,8">
                        <TextBlock Text="SHA-256 Hash" FontWeight="SemiBold" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ComputeSha512Command}" Height="36" Padding="14,0" Margin="0,0,8,8">
                        <TextBlock Text="SHA-512 Hash" FontWeight="SemiBold" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ComputeMd5Command}" Height="36" Padding="14,0" Margin="0,0,8,8">
                        <TextBlock Text="MD5 Checksum" FontWeight="SemiBold" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ComputeFileChecksumsCommand}" Height="36" Padding="14,0" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Folder}" Fill="{StaticResource Brush.Text.Primary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="File Checksum Report..." FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding InspectFileHexCommand}" Height="36" Padding="14,0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Code}" Fill="{StaticResource Brush.Text.Primary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="File Hex Viewer..." FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>

            <!-- Split Input / Output Panels -->
            <Grid Grid.Row="2" MinHeight="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Input Panel -->
                <Border Grid.Column="0" Style="{StaticResource NexusCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="INPUT DATA / TEXT / RAW PAYLOAD" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,10" />
                        <TextBox Grid.Row="1" Style="{StaticResource NexusTextBoxStyle}" Text="{Binding InputData, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontFamily.Monospace}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="320" />
                    </Grid>
                </Border>

                <!-- Output Panel -->
                <Border Grid.Column="2" Style="{StaticResource NexusCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="OUTPUT / CHECKSUM / FORMATTED RESULT" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,10" />
                        <TextBox Grid.Row="1" Style="{StaticResource NexusTextBoxStyle}" Text="{Binding OutputData}" FontFamily="{StaticResource FontFamily.Monospace}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="320" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
