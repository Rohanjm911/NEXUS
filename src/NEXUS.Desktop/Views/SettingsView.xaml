<UserControl x:Class="NEXUS.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NEXUS.Desktop.ViewModels"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <TextBlock Text="NEXUS SETTINGS" FontSize="{StaticResource FontSize.Hero}" FontWeight="Bold" />
            <TextBlock Text="Personalization, performance limits, security preferences and telemetry" FontSize="{StaticResource FontSize.Subheader}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,24" />

            <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="APPEARANCE &amp; THEME" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,12" />
                    <ComboBox SelectedIndex="{Binding ThemeIndex}" Height="36" Width="240" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Obsidian Dark (Default)" />
                        <ComboBoxItem Content="Clean Light" />
                        <ComboBoxItem Content="System Adaptive" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="PERFORMANCE &amp; CONCURRENCY" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding MaxConcurrency, StringFormat={}Maximum Parallel Tasks: {0}}" FontSize="{StaticResource FontSize.Body}" Margin="0,0,0,8" />
                    <Slider Minimum="1" Maximum="16" Value="{Binding MaxConcurrency}" Width="300" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource NexusCardStyle}">
                <StackPanel>
                    <TextBlock Text="ABOUT NEXUS" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,8" />
                    <TextBlock Text="NEXUS Desktop Studio — Version 1.0.0" FontWeight="Bold" />
                    <TextBlock Text="Local-First, Privacy-Protected Universal Processing Platform." FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" />
                    <TextBlock Text="No mandatory cloud accounts. No automatic file telemetry." FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

