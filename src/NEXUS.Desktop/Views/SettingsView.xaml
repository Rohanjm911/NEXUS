<UserControl x:Class="NEXUS.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NEXUS.Desktop.ViewModels"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="NEXUS SETTINGS &amp; PREFERENCES" FontSize="{StaticResource FontSize.Hero}" FontWeight="Black" />
                    <Border Style="{StaticResource NexusBadgeStyle}" Background="{DynamicResource Brush.Accent.Primary}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DUAL-TONE // NEO-BRUTALIST" FontSize="10" FontWeight="Black" Foreground="{DynamicResource Brush.Text.OnAccent}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Personalization, hardware concurrency, background engine IPC and privacy preferences" FontSize="{StaticResource FontSize.Subheader}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Appearance & Theme Card -->
            <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="// APPEARANCE &amp; DUAL-TONE PALETTE" FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.Small}" FontWeight="Black" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,12" />
                    <ComboBox SelectedIndex="{Binding ThemeIndex}" Height="38" Width="380" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="Neo-Brutalist Obsidian (Dual-Tone Dark)" IsSelected="True" />
                        <ComboBoxItem Content="Neo-Brutalist Paper (Dual-Tone Light)" />
                        <ComboBoxItem Content="System Adaptive (Windows 11 Preference)" />
                    </ComboBox>
                    <TextBlock Text="Changes apply live dynamically across all windows and controls without requiring an app restart." FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                </StackPanel>
            </Border>

            <!-- Performance & Concurrency Card -->
            <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="// PERFORMANCE &amp; ENGINE CONCURRENCY" FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.Small}" FontWeight="Black" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,8" MaxWidth="400" HorizontalAlignment="Left">
                        <TextBlock Text="Maximum Parallel Processing Threads" FontSize="{StaticResource FontSize.Body}" FontWeight="Bold" />
                        <TextBlock Text="{Binding MaxConcurrency, StringFormat={}{0} Workers}" FontFamily="{StaticResource FontFamily.Monospace}" FontWeight="Black" Foreground="{DynamicResource Brush.Accent.Primary}" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider Minimum="1" Maximum="16" Value="{Binding MaxConcurrency}" Width="400" HorizontalAlignment="Left" Margin="0,0,0,12" />
                    <TextBlock Text="Controls how many worker threads run concurrently in the Rust Tokio native engine." FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                </StackPanel>
            </Border>

            <!-- Engine Architecture & Telemetry Card -->
            <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="// BACKGROUND ENGINE &amp; IPC" FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.Small}" FontWeight="Black" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Daemon Pipe Endpoint:" FontSize="{StaticResource FontSize.Small}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock Grid.Column="1" Text="\\.\pipe\nexus-engine" FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.Small}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Primary}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Task Database Storage:" FontSize="{StaticResource FontSize.Small}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock Grid.Column="1" Text="Local SQLite (Encrypted / Isolated WAL Mode)" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Primary}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Privacy &amp; Telemetry:" FontSize="{StaticResource FontSize.Small}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock Grid.Column="1" Text="Zero Cloud Telemetry • 100% Local-First Processing" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Status.SuccessText}" FontWeight="Bold" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About NEXUS Card -->
            <Border Style="{StaticResource NexusCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="2" Background="{DynamicResource Brush.Background.Tertiary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="2" Margin="0,0,20,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="0" Direction="315" ShadowDepth="3" Opacity="1" Color="{DynamicResource Color.Shadow.Hard}" />
                        </Border.Effect>
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NEXUS Desktop Studio — Version 2.0 (Dual-Tone Neo-Brutalist Edition)" FontWeight="Black" FontSize="{StaticResource FontSize.Header}" />
                        <TextBlock Text="Universal File Conversion &amp; Processing Platform for Windows 10 &amp; 11" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
                        <TextBlock Text="Engineered with C# .NET 11 WPF &amp; Rust Tokio Native Engine. Licensed under MIT." FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
