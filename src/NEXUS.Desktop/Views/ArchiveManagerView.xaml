<UserControl x:Class="NEXUS.Desktop.Views.ArchiveManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NEXUS.Desktop.ViewModels"
             Background="Transparent"
             AllowDrop="True"
             DragOver="OnDragEnter"
             Drop="OnDropFiles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            <!-- Studio Header -->
            <StackPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ARCHIVE MANAGER" FontSize="{StaticResource FontSize.Hero}" FontWeight="Bold" />
                    <Border Style="{StaticResource NexusBadgeStyle}" Background="{DynamicResource Brush.Accent.Muted}" Margin="12,0,0,0">
                        <TextBlock Text="COMPRESSION VAULT • PATH TRAVERSAL PROTECTED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Hover}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="High-ratio SIMD compression, multi-file archive creation and secure extraction with Zip-Slip path traversal protection" FontSize="{StaticResource FontSize.Subheader}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Mode Selector Tabs -->
            <Border Background="{DynamicResource Brush.Background.Secondary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,16" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ToggleModeCommand}" Height="34" Padding="20,0" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExtractMode}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Archive}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Create Archive Vault" FontWeight="Bold" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ToggleModeCommand}" Height="34" Padding="20,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExtractMode}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Folder}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Extract Archive Package" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ========================================================== -->
            <!-- VIEW 1: CREATE ARCHIVE VAULT                               -->
            <!-- ========================================================== -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExtractMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Vault Control Bar -->
                <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Format Pills -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CONTAINER:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectArchiveFormatCommand}" CommandParameter="tar.gz" Height="30" Padding="12,0" Margin="0,0,6,0">
                                <TextBlock Text=".tar.gz (GZIP)" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectArchiveFormatCommand}" CommandParameter="zip" Height="30" Padding="12,0" Margin="0,0,6,0">
                                <TextBlock Text=".zip (Universal)" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectArchiveFormatCommand}" CommandParameter="tar" Height="30" Padding="12,0">
                                <TextBlock Text=".tar (Tape)" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddFilesCommand}" Height="36" Padding="18,0" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Add}" Fill="{DynamicResource Brush.Text.OnAccent}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Add Files to Vault..." FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearFilesCommand}" Height="36" Padding="14,0">
                                <TextBlock Text="Clear List" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Centerpiece File Vault Staging Table -->
                <Border Style="{StaticResource NexusCardStyle}" MinHeight="260" Margin="0,0,0,16" Background="{DynamicResource Brush.Background.Secondary}" BorderBrush="{DynamicResource Brush.Border.Active}">
                    <Grid>
                        <!-- List of Files -->
                        <ListBox ItemsSource="{Binding FilesToArchive}" Background="Transparent" BorderThickness="0" Margin="8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Background.Tertiary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- File Icon -->
                                            <Border Grid.Column="0" Background="{DynamicResource Brush.Accent.Muted}" CornerRadius="4" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Archive}" Fill="{DynamicResource Brush.Accent.Hover}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- File Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="{StaticResource FontSize.Body}" />
                                                <TextBlock Text="Staged file payload queued for compression" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <!-- Delete Button -->
                                            <Button Grid.Column="2" Style="{StaticResource WindowCloseButtonStyle}" Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Width="30" Height="30" VerticalAlignment="Center" ToolTip="Remove from Vault">
                                                <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.Text.Secondary}" Width="10" Height="10" Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State Dropzone -->
                        <Border Background="{DynamicResource Brush.Background.DropZone}" BorderBrush="{DynamicResource Brush.Border.DropZone}" BorderThickness="1.5" CornerRadius="6" Padding="32" Margin="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilesToArchive.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Archive}" Fill="{DynamicResource Brush.Accent.Primary}" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="Archive Staging Vault is Empty" FontSize="{StaticResource FontSize.Header}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" />
                                <TextBlock Text="Click 'Add Files to Vault...' or drag &amp; drop files and folders here to package into an archive" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,4,0,14" />
                                <Border Style="{StaticResource NexusBadgeStyle}" Background="{DynamicResource Brush.Accent.Muted}" HorizontalAlignment="Center">
                                    <TextBlock Text="Automatic checksum validation • Zero memory leaks • Rust SIMD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Hover}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Compression Level & Security Deck (Two Columns) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Compression Level Chips -->
                    <Border Grid.Column="0" Style="{StaticResource NexusCardStyle}">
                        <StackPanel>
                            <TextBlock Text="COMPRESSION RATIO &amp; SPEED" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,12" />
                            <WrapPanel Margin="0,0,0,12">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectCompressionLevelCommand}" CommandParameter="Store (0% CPU)" Height="28" Padding="10,0" Margin="0,0,6,6">
                                    <TextBlock Text="Store (0% CPU)" FontSize="11" FontWeight="SemiBold" />
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectCompressionLevelCommand}" CommandParameter="Fast (Low Ratio)" Height="28" Padding="10,0" Margin="0,0,6,6">
                                    <TextBlock Text="Fast (Quick)" FontSize="11" FontWeight="SemiBold" />
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectCompressionLevelCommand}" CommandParameter="Normal (Balanced)" Height="28" Padding="10,0" Margin="0,0,6,6">
                                    <TextBlock Text="Normal (Balanced)" FontSize="11" FontWeight="SemiBold" />
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectCompressionLevelCommand}" CommandParameter="Maximum (LZMA2)" Height="28" Padding="10,0" Margin="0,0,6,6">
                                    <TextBlock Text="Maximum (LZMA2)" FontSize="11" FontWeight="SemiBold" />
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectCompressionLevelCommand}" CommandParameter="Ultra (SIMD)" Height="28" Padding="10,0" Margin="0,0,6,6">
                                    <TextBlock Text="Ultra (SIMD)" FontSize="11" FontWeight="SemiBold" />
                                </Button>
                            </WrapPanel>
                            <ComboBox ItemsSource="{Binding CompressionLevels}" SelectedItem="{Binding CompressionLevel}" Height="38" />
                        </StackPanel>
                    </Border>

                    <!-- Security & Protection -->
                    <Border Grid.Column="2" Style="{StaticResource NexusCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SECURITY &amp; PATH TRAVERSAL GUARD" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,12" />
                            <Border Background="{DynamicResource Brush.Accent.Muted}" BorderBrush="{DynamicResource Brush.Accent.Primary}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource Icon.Shield}" Fill="{DynamicResource Brush.Accent.Hover}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Zip-Slip Vulnerability Shield Active" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Accent.Hover}" />
                                        <TextBlock Text="All archive paths are sanitized against directory traversal attacks (CVE-2018-1002200)." FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0" LineHeight="16" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Vault Encryption Key (Optional)" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource NexusTextBoxStyle}" Text="{Binding EncryptionPassword, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Tag="AES-256 Key" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bottom Action & Create Dock -->
                <Border Style="{StaticResource NexusCardStyle}">
                    <Grid>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent.Hover}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,240,0" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding OpenOutputFolderCommand}" Height="42" Padding="16,0" Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanOpenOutput}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Folder}" Fill="{DynamicResource Brush.Text.Primary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Open File in Folder" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateArchiveCommand}" Height="42" Padding="28,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Archive}" Fill="{DynamicResource Brush.Text.OnAccent}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Create Compressed Archive" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ========================================================== -->
            <!-- VIEW 2: EXTRACT ARCHIVE CONTROLS                           -->
            <!-- ========================================================== -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExtractMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <!-- Archive Source -->
                        <TextBlock Text="ARCHIVE TO EXTRACT" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource NexusTextBoxStyle}" Text="{Binding ExtractSourcePath, TargetNullValue='Select or drag &amp; drop an archive file (.zip, .tar.gz, .tar)...'}" IsReadOnly="True" Height="38" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseExtractSourceCommand}" Margin="10,0,0,0" Height="38" Padding="18,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Folder}" Fill="{DynamicResource Brush.Text.Primary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Browse Archive..." FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Destination Folder -->
                        <TextBlock Text="EXTRACTION DESTINATION DIRECTORY" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource NexusTextBoxStyle}" Text="{Binding ExtractDestinationPath, TargetNullValue='Default: Extracted into a folder named after the archive'}" IsReadOnly="True" Height="38" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseExtractDestinationCommand}" Margin="10,0,0,0" Height="38" Padding="18,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Folder}" Fill="{DynamicResource Brush.Text.Primary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Choose Folder..." FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Security Features Card -->
                        <Border Background="{DynamicResource Brush.Background.Tertiary}" CornerRadius="6" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Shield}" Fill="{DynamicResource Brush.Accent.Primary}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Secure Extraction Protocol" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Accent.Hover}" />
                                    <TextBlock Text="NEXUS verifies every entry inside the archive before writing to disk. Any file attempting to write outside the destination directory using '../' sequences will be automatically blocked and reported." FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" LineHeight="17" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Action Bar for Extraction -->
                <Border Style="{StaticResource NexusCardStyle}">
                    <Grid>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent.Hover}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,240,0" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding OpenOutputFolderCommand}" Height="42" Padding="16,0" Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanOpenOutput}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Folder}" Fill="{DynamicResource Brush.Text.Primary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Open Extracted Folder" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExtractArchiveCommand}" Height="42" Padding="28,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Folder}" Fill="{DynamicResource Brush.Text.OnAccent}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Extract Archive Now" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>