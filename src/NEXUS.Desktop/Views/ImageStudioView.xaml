<UserControl x:Class="NEXUS.Desktop.Views.ImageStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NEXUS.Desktop.ViewModels"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <TextBlock Text="IMAGE STUDIO" FontSize="{StaticResource FontSize.Hero}" FontWeight="Bold" />
            <TextBlock Text="Resize, crop, convert, optimize and strip metadata with Rust performance" FontSize="{StaticResource FontSize.Subheader}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,24" />

            <!-- File Selection Card -->
            <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SOURCE IMAGE" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource NexusTextBoxStyle}" Text="{Binding SourceImagePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseImageCommand}" VerticalAlignment="Bottom" Margin="12,0,0,0" Height="36">
                        <TextBlock Text="Browse Image..." />
                    </Button>
                </Grid>
            </Border>

            <!-- Configuration Grid -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Resolution & Quality -->
                <Border Grid.Column="0" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <TextBlock Text="TRANSFORMATION SETTINGS" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Width (px)" FontSize="{StaticResource FontSize.Small}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource NexusTextBoxStyle}" Text="{Binding TargetWidth, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Height (px)" FontSize="{StaticResource FontSize.Small}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource NexusTextBoxStyle}" Text="{Binding TargetHeight, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Quality, StringFormat={}Quality: {0}%}" FontSize="{StaticResource FontSize.Small}" Margin="0,0,0,4" />
                        <Slider Minimum="1" Maximum="100" Value="{Binding Quality}" Margin="0,0,0,16" />

                        <CheckBox IsChecked="{Binding StripMetadata}" Foreground="{StaticResource Brush.Text.Primary}" Content="Strip EXIF / Camera Metadata (Privacy Protection)" />
                    </StackPanel>
                </Border>

                <!-- Right Column: Output Format -->
                <Border Grid.Column="2" Style="{StaticResource NexusCardStyle}">
                    <StackPanel>
                        <TextBlock Text="OUTPUT FORMAT" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,16" />
                        <ComboBox ItemsSource="{Binding SupportedFormats}" SelectedItem="{Binding TargetFormat}" Height="36" Margin="0,0,0,16" />
                        <TextBlock Text="Recommended for web: WebP (up to 30% smaller than JPEG with identical quality)." FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action & Status -->
            <Border Style="{StaticResource NexusCardStyle}">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource Brush.Accent.Hover}" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ProcessImageCommand}" HorizontalAlignment="Right" Padding="24,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Image}" Fill="{StaticResource Brush.Text.OnAccent}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Process Image" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
