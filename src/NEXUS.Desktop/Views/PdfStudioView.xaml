<UserControl x:Class="NEXUS.Desktop.Views.PdfStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NEXUS.Desktop.ViewModels"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="PDF STUDIO" FontSize="{StaticResource FontSize.Hero}" FontWeight="Bold" />
                <TextBlock Text="Merge multiple PDFs, reorder pages, extract pages and compress documents" FontSize="{StaticResource FontSize.Subheader}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <TextBlock Text="SELECTED PDF DOCUMENTS" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddPdfCommand}" HorizontalAlignment="Right">
                        <TextBlock Text="Add PDF Files..." />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource NexusCardStyle}" MinHeight="220">
                <ListBox ItemsSource="{Binding PdfFiles}" Background="Transparent" BorderThickness="0" />
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource Brush.Accent.Hover}" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding MergePdfCommand}" HorizontalAlignment="Right" Padding="24,10">
                    <TextBlock Text="Merge Selected PDFs" FontWeight="Bold" />
                </Button>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
