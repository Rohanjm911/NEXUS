<UserControl x:Class="NEXUS.Desktop.Views.PdfStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NEXUS.Desktop.ViewModels"
             Background="Transparent"
             AllowDrop="True"
             DragOver="OnDragEnter"
             Drop="OnDropFiles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            <!-- Studio Header -->
            <StackPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PDF STUDIO" FontSize="{StaticResource FontSize.Hero}" FontWeight="Bold" />
                    <Border Style="{StaticResource NexusBadgeStyle}" Background="{DynamicResource Brush.Accent.Muted}" Margin="12,0,0,0">
                        <TextBlock Text="DOCUMENT PUBLISHER &amp; BINDER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Hover}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Merge multiple PDF documents, reorder pages, organize document archives and produce unified publications" FontSize="{StaticResource FontSize.Subheader}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Binder Control Bar -->
            <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16" Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.Pdf}" Fill="{DynamicResource Brush.Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                        <TextBlock Text="DOCUMENT STAGING BOARD" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Style="{StaticResource NexusBadgeStyle}" Background="{DynamicResource Brush.Background.Tertiary}" Margin="12,0,0,0">
                            <TextBlock Text="{Binding TotalPdfCount, StringFormat={}{0} Documents Staged}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Hover}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddPdfCommand}" Height="36" Padding="18,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Folder}" Fill="{DynamicResource Brush.Text.OnAccent}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Add PDF Documents..." FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearPdfCommand}" Height="36" Padding="14,0">
                            <TextBlock Text="Clear All" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Interactive Staging List -->
            <Border Style="{StaticResource NexusCardStyle}" MinHeight="260" Margin="0,0,0,16" Background="{DynamicResource Brush.Background.Secondary}" BorderBrush="{DynamicResource Brush.Border.Active}">
                <Grid>
                    <!-- PDF Documents Collection -->
                    <ListBox ItemsSource="{Binding PdfFiles}" Background="Transparent" BorderThickness="0" Margin="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Background.Tertiary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- PDF Icon -->
                                        <Border Grid.Column="0" Background="{DynamicResource Brush.Accent.Muted}" CornerRadius="4" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Pdf}" Fill="{DynamicResource Brush.Accent.Hover}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Document Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="{StaticResource FontSize.Body}" />
                                            <TextBlock Text="PDF Document staged for sequential linear page bind" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <!-- Move Up / Move Down Reordering Controls -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                            <Button Style="{StaticResource WindowButtonStyle}" Command="{Binding DataContext.MovePdfUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Width="30" Height="30" Margin="0,0,4,0" ToolTip="Move Up in Bind Sequence">
                                                <Path Data="{StaticResource Icon.ArrowUp}" Fill="{DynamicResource Brush.Text.Secondary}" Width="12" Height="12" Stretch="Uniform" />
                                            </Button>
                                            <Button Style="{StaticResource WindowButtonStyle}" Command="{Binding DataContext.MovePdfDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Width="30" Height="30" ToolTip="Move Down in Bind Sequence">
                                                <Path Data="{StaticResource Icon.ArrowDown}" Fill="{DynamicResource Brush.Text.Secondary}" Width="12" Height="12" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Delete Item Button -->
                                        <Button Grid.Column="3" Style="{StaticResource WindowCloseButtonStyle}" Command="{Binding DataContext.RemovePdfCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Width="30" Height="30" VerticalAlignment="Center" ToolTip="Remove from Queue">
                                            <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.Text.Secondary}" Width="10" Height="10" Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State Placeholder -->
                    <Border Background="{DynamicResource Brush.Background.DropZone}" BorderBrush="{DynamicResource Brush.Border.DropZone}" BorderThickness="1.5" CornerRadius="6" Padding="32" Margin="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PdfFiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Pdf}" Fill="{DynamicResource Brush.Accent.Primary}" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="No PDF Documents Staged" FontSize="{StaticResource FontSize.Header}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" />
                            <TextBlock Text="Click 'Add PDF Documents...' or drag &amp; drop 2 or more PDF files here to bind into a single publication" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,4,0,14" />
                            <Border Style="{StaticResource NexusBadgeStyle}" Background="{DynamicResource Brush.Accent.Muted}" HorizontalAlignment="Center">
                                <TextBlock Text="PDF 1.4 - 2.0 • Vector Graphics • High-DPI Print Ready" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Hover}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Binder Output Settings Deck -->
            <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Output File Name -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="OUTPUT FILE NAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource NexusTextBoxStyle}" Text="{Binding OutputPdfName, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Page Range & Options -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PAGE EXTRACTION &amp; NORMALIZATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource NexusTextBoxStyle}" Text="{Binding PageRange, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Action & Merge Dock -->
            <Border Style="{StaticResource NexusCardStyle}">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent.Hover}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,240,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding OpenOutputFolderCommand}" Height="42" Padding="16,0" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanOpenOutput}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Folder}" Fill="{DynamicResource Brush.Text.Primary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Open File in Folder" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding MergePdfCommand}" Height="42" Padding="28,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Pdf}" Fill="{DynamicResource Brush.Text.OnAccent}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Merge PDF Documents" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>